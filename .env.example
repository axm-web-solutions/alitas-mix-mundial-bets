# Copy this file to .env.local for development
# OR configure these variables in your hosting provider's dashboard

# Supabase - Client (REQUIRED for frontend)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase - Server (OPTIONAL - only if using server-side auth)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_JWT_SECRET=your-jwt-secret

# Football Data API (OPTIONAL - currently not used in production)
# VITE_FOOTBALL_DATA_API_URL=https://api.football-data.org/v4
# VITE_FOOTBALL_DATA_API_KEY=your-api-key-here
